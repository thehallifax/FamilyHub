# =============================================================================
# FamilyHub Environment Variables
# =============================================================================
# Copy this file to .env for the household Compose stack, then fill in every
# required value. Both LAN HTTPS and MacBook loopback staging use this file.
# The actual .env file is ignored by Git.
# For standalone Vite development, copy only the VITE_* setting to .env.local.
# Vite only exposes variables prefixed with VITE_ to the client
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Base URL for API requests
# Default: "/api" (relative, proxied to localhost:8080 by Vite dev server)
# A running backend is required for development (npm run dev needs backend on :8080
# or use docker compose).
# Examples:
#   - "/api" for same-origin backend (default, proxied by Vite)
#   - "https://api.familyhub.example.com" for separate API server
VITE_API_BASE_URL=/api

# -----------------------------------------------------------------------------
# Household Compose deployment (see docs/HOUSEHOLD-DEPLOYMENT.md)
# -----------------------------------------------------------------------------

# IPv4 address of the MacBook or Mac mini on your LAN. Reserve this address in
# your router before installing the PWA on other devices.
FAMILYHUB_LAN_IP=192.168.1.10
# Optional production hostname for Google OAuth. Leave unset for the existing
# LAN-IP HTTPS site; set only after arranging LAN DNS, trusted TLS, and Google
# OAuth approval for this exact hostname. Caddy remains bound to the LAN IP.
# FAMILYHUB_SITE_HOST=family.example.com

# Uncommitted MacBook staging uses dev; production uses approved commit SHAs.
FAMILYHUB_FRONTEND_IMAGE_TAG=dev
# Backend checkout is a sibling of this frontend repository by default.
# Use a commit SHA as the image tag only after checking out that exact backend
# commit (see docs/HOUSEHOLD-DEPLOYMENT.md). Uncommitted staging uses "dev".
FAMILYHUB_BACKEND_CONTEXT=../family-hub-api
FAMILYHUB_BACKEND_IMAGE_TAG=dev

# Generate independently; never reuse the committed E2E test secrets.
# JWT_SECRET: openssl rand -base64 48
# TOKEN_ENCRYPTION_KEY: openssl rand -base64 32
# POSTGRES_PASSWORD: openssl rand -hex 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Optional. Leave both empty until Google Calendar is deliberately enabled.
# Google requires a registered localhost web callback for local testing; a raw
# LAN IP is not suitable for production web OAuth redirects.
# Base Compose uses FAMILYHUB_SITE_HOST when set, otherwise FAMILYHUB_LAN_IP.
# GOOGLE_FRONTEND_REDIRECT is the plain origin (without any query string). The
# local override changes both to http://localhost:8080 equivalents.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SolarEdge Energy: billing anniversary and zone belong to the developer account,
# not necessarily the solar site. Verify them before enabling collection.
ENERGY_BILLING_DAY=1
ENERGY_BILLING_TIMEZONE=UTC
# Applied only when importing a new connection; existing intervals are retained.
# Site timezone is a separate required argument to the credential importer.
ENERGY_POLL_INTERVAL_MINUTES=15
ENERGY_SCHEDULER_DELAY_MS=60000
ENERGY_SCHEDULER_INITIAL_DELAY_MS=60000
# Set all three privately to the verified installation; missing values disable collection.
ENERGY_DAYLIGHT_SITE_ID=
ENERGY_DAYLIGHT_LATITUDE=
ENERGY_DAYLIGHT_LONGITUDE=

# -----------------------------------------------------------------------------
# Development/Testing Flags
# -----------------------------------------------------------------------------

# E2E testing mode
# - Disables TanStack Query DevTools
# - Reduces simulated API delays for faster tests
# Set by Playwright automatically; don't set manually
# VITE_E2E=true

# -----------------------------------------------------------------------------
# localStorage Keys Reference
# -----------------------------------------------------------------------------
# family-hub-family           - Family data (TanStack Query cache seed)
# family-hub-calendar-events  - Calendar events (API cache)
# family-hub-calendar-ui      - Calendar UI preferences (Zustand persist)
