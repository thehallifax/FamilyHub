# =============================================================================
# FamilyHub Environment Variables
# =============================================================================
# Copy this file to .env for the household Compose stack, then fill in every
# required value. Both LAN HTTPS and MacBook loopback staging use this file.
# The actual .env file is ignored by Git.
# For standalone Vite development, copy only the VITE_* setting to .env.local.
# Vite only exposes variables prefixed with VITE_ to the client
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Base URL for API requests
# Default: "/api" (relative, proxied to localhost:8080 by Vite dev server)
# A running backend is required for development (npm run dev needs backend on :8080
# or use docker compose).
# Examples:
#   - "/api" for same-origin backend (default, proxied by Vite)
#   - "https://api.familyhub.example.com" for separate API server
VITE_API_BASE_URL=/api

# -----------------------------------------------------------------------------
# Household Compose deployment (see docs/HOUSEHOLD-DEPLOYMENT.md)
# -----------------------------------------------------------------------------

# IPv4 address of the MacBook or Mac mini on your LAN. Reserve this address in
# your router before installing the PWA on other devices.
FAMILYHUB_LAN_IP=192.168.1.10

# Generate independently; never reuse the committed E2E test secrets.
# JWT_SECRET: openssl rand -base64 48
# TOKEN_ENCRYPTION_KEY: openssl rand -base64 32
# POSTGRES_PASSWORD: openssl rand -hex 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Optional. Leave both empty until Google Calendar is deliberately enabled.
# The Compose stack sets GOOGLE_REDIRECT_URI to
# https://FAMILYHUB_LAN_IP/api/google/callback and GOOGLE_FRONTEND_REDIRECT to
# the plain https://FAMILYHUB_LAN_IP origin (without any query string).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Development/Testing Flags
# -----------------------------------------------------------------------------

# E2E testing mode
# - Disables TanStack Query DevTools
# - Reduces simulated API delays for faster tests
# Set by Playwright automatically; don't set manually
# VITE_E2E=true

# -----------------------------------------------------------------------------
# localStorage Keys Reference
# -----------------------------------------------------------------------------
# family-hub-family           - Family data (TanStack Query cache seed)
# family-hub-calendar-events  - Calendar events (API cache)
# family-hub-calendar-ui      - Calendar UI preferences (Zustand persist)
